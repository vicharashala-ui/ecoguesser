      "layout": {
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#9ec3d6",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.2
          ],
          [
            "zoom"
          ],
          4,
          0.8,
          8,
          1.2,
          11,
          1.6,
          20,
          6
